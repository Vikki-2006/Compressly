# ─────────────────────────────────────────────────────────────────────────────
# Compressly Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit your .env file!
# ─────────────────────────────────────────────────────────────────────────────

# Application environment: "development" | "production"
# In development: hot-reload is enabled. In production: disabled.
ENV=development

# JWT Secret Key — generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-key-here

# ─── Railway Deployment ───────────────────────────────────────────────────────

# Port — Railway sets this automatically. Do NOT set manually on Railway.
# For local dev, defaults to 8000.
# PORT=8000

# CORS Allowed Origins — set to your Vercel frontend URL in production.
# For local dev, leave as "*" or omit entirely.
# Multiple origins: ALLOWED_ORIGINS=https://app.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=*

# (Optional) Custom data directory for uploads/compressed/temp storage.
# Defaults to <backend_root>/uploads, <backend_root>/compressed, <backend_root>/temp
# DATA_DIR=/custom/storage/path

# (Optional) Custom database URL. Defaults to SQLite at <backend_root>/history.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=sqlite:////absolute/path/to/history.db

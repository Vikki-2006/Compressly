# ─────────────────────────────────────────────────────────────────────────────
# Compressly Frontend — Environment Variables
# Copy this file to .env and fill in real values. Never commit your .env file!
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL
# - Local development: http://localhost:8000
# - Vercel production: set to your Railway backend URL
#   e.g. https://compressly-api.up.railway.app
VITE_API_URL=http://localhost:8000
